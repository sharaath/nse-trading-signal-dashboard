# MarketSignalBot System Configuration (Oracle Cloud Always Free VM)

# --- SYSTEM MODE & SAFETY ENFORCEMENT ---
# Enforce paper trading mode only (production default)
SYSTEM_MODE=PAPER
REAL_ORDERS_ENABLED=false

# Options: 'angelone' (Angel One SmartAPI), 'realtime' (Fyers WebSockets), or 'yfinance' (Yahoo Finance REST API)
MARKET_DATA_PROVIDER=realtime
ALLOW_FALLBACK_SIMULATION=false
FORCE_SCAN=true

# --- ANGEL ONE (SmartAPI) CREDENTIALS ---
# Register developer account at smartapi.angelbroking.com
ANGEL_API_KEY=your_smartapi_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PIN=1234
ANGEL_TOTP_KEY=JBSWY3DPEHPK3PXP
ANGEL_JWT_TOKEN=optional_pregenerated_jwt
ANGEL_FEED_TOKEN=optional_pregenerated_feed_token

# --- FYERS API CREDENTIALS ---
# Register developer account at api.fyers.in to generate these
FYERS_CLIENT_ID=your_fyers_client_id
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_ACCESS_TOKEN=your_fyers_access_token
# Optional credentials for automated daily morning 2FA token refresh (scripts/fyers_auto_login.py)
FYERS_PIN=1234
FYERS_TOTP_KEY=JBSWY3DPEHPK3PXP

# --- TELEGRAM BOT CONFIGURATION ---
# Telegram API Token received from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Default Chat ID or Channel ID to dispatch channel alerts (e.g. -100123456789)
TELEGRAM_CHAT_ID=-1000000000000
# Optional comma-separated list of allowed Telegram user IDs (whitelist)
TELEGRAM_ALLOWED_USERS=8155702819

# Service flags (in docker-compose, worker and bot handle these)
ENABLE_API_SCANNER=false
ENABLE_TELEGRAM_IN_API=false

# --- DATABASE PARAMETERS (Docker Compose defaults) ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/marketsignalbot
POSTGRES_DB=marketsignalbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
